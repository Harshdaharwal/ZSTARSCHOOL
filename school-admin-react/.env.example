# Copy to .env.local and fill in your Firebase Web App config values.
# Get values from: Firebase Console → Project Settings → Your apps → Web app → SDK setup
# Leave VITE_FIREBASE_API_KEY unset to use offline mock auth + demo accounts.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# WhatsApp Maytapi Configuration
# Get values from: https://console.maytapi.com → Settings → Token
VITE_MAYTAPI_PRODUCT_ID=
VITE_MAYTAPI_TOKEN=
VITE_MAYTAPI_PHONE_ID=
